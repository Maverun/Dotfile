#!/usr/bin/sh

# DP-2 = Right monitor
# DP-1 = Middle monitor (main)
# HDMI-A-1 = Left monitor
# DP-3 = Top monitor

# Default all monitor connecting.
#!/bin/bash

notify-send "Changing window mode" "$1"

if [[ $1 == "4Monitor" ]]; then
	hyprctl eval 'hl.monitor({ output = "HDMI-A-1", resolution = "1920x1080@60", position = "0x1440" })'
	hyprctl eval 'hl.monitor({ output = "DP-1", resolution = "2560x1440@240", position = "1920x1080" })'
	hyprctl eval 'hl.monitor({ output = "DP-2", resolution = "1920x1080@60", position = "4480x1440" })'
	hyprctl eval 'hl.monitor({ output = "DP-3", resolution = "1920x1080", position = "1920x0" })'

elif [[ $1 == "3Monitor" ]]; then
	hyprctl eval 'hl.monitor({ output = "HDMI-A-1", resolution = "1920x1080@60", position = "0x360" })'
	hyprctl eval 'hl.monitor({ output = "DP-1", resolution = "2560x1440@240", position = "1920x0" })'
	hyprctl eval 'hl.monitor({ output = "DP-2", resolution = "1920x1080@60", position = "4480x360" })'
	hyprctl eval 'hl.monitor({ output = "DP-3", disabled = true })'

elif [[ $1 == "2MonitorLeft" ]]; then
	hyprctl eval 'hl.monitor({ output = "HDMI-A-1", resolution = "1920x1080@60", position = "0x360" })'
	hyprctl eval 'hl.monitor({ output = "DP-1", resolution = "2560x1440@240", position = "1920x0" })'
	hyprctl eval 'hl.monitor({ output = "DP-2", disabled = true })'
	hyprctl eval 'hl.monitor({ output = "DP-3", disabled = true })'

elif [[ $1 == "2MonitorRight" ]]; then
	hyprctl eval 'hl.monitor({ output = "HDMI-A-1", disabled = true })'
	hyprctl eval 'hl.monitor({ output = "DP-1", resolution = "2560x1440@240", position = "0x0" })'
	hyprctl eval 'hl.monitor({ output = "DP-2", resolution = "1920x1080@60", position = "2560x360" })'
	hyprctl eval 'hl.monitor({ output = "DP-3", disabled = true })'

elif [[ $1 == "1Monitor" ]]; then
	hyprctl eval 'hl.monitor({ output = "HDMI-A-1", disabled = true })'
	hyprctl eval 'hl.monitor({ output = "DP-1", resolution = "2560x1440@240", position = "0x0" })'
	hyprctl eval 'hl.monitor({ output = "DP-2", disabled = true })'
	hyprctl eval 'hl.monitor({ output = "DP-3", disabled = true })'
fi

notify-send "Monitor settings updated"
# sh ~/Script/monitorSet
