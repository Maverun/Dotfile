#!/bin/bash

notify-send "Switching monitors..." "$1"

case "$1" in
  "4Monitor")
    echo "Configuring 4Monitor layout..."
    hyprctl eval "hl.monitor({ output = 'DP-3', disabled = false, mode = '1920x1080@60', position = '1920x0', scale = 1 })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'DP-2', disabled = false, mode = '1920x1080@60', position = '4480x360', scale = 1 })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'HDMI-A-1', disabled = false, mode = '1920x1080@60', position = '0x360', scale = 1 })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'DP-1', disabled = false, mode = '2560x1440@240', position = '1920x0', scale = 1 })"
    sleep 1
    echo "4Monitor setup complete"
    ;;
  "3Monitor")
    echo "Configuring 3Monitor layout..."
    hyprctl eval "hl.monitor({ output = 'DP-3', disabled = true })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'DP-2', disabled = false, mode = '1920x1080@60', position = '4480x360', scale = 1 })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'HDMI-A-1', disabled = false, mode = '1920x1080@60', position = '0x360', scale = 1 })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'DP-1', disabled = false, mode = '2560x1440@240', position = '1920x0', scale = 1 })"
    sleep 1
    echo "3Monitor setup complete"
    ;;
  "2MonitorLeft")
    echo "Configuring 2MonitorLeft layout..."
    hyprctl eval "hl.monitor({ output = 'DP-3', disabled = true })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'DP-2', disabled = true })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'HDMI-A-1', disabled = false, mode = '1920x1080@60', position = '0x360', scale = 1 })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'DP-1', disabled = false, mode = '2560x1440@240', position = '1920x0', scale = 1 })"
    sleep 1
    echo "2MonitorLeft setup complete"
    ;;
  "2MonitorRight")
    echo "Configuring 2MonitorRight layout..."
    hyprctl eval "hl.monitor({ output = 'DP-3', disabled = true })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'HDMI-A-1', disabled = true })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'DP-2', disabled = false, mode = '1920x1080@60', position = '2560x360', scale = 1 })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'DP-1', disabled = false, mode = '2560x1440@240', position = '0x0', scale = 1 })"
    sleep 1
    echo "2MonitorRight setup complete"
    ;;
  "1Monitor")
    echo "Configuring 1Monitor layout..."
    hyprctl eval "hl.monitor({ output = 'DP-3', disabled = true })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'DP-2', disabled = true })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'HDMI-A-1', disabled = true })"
    sleep 0.3
    hyprctl eval "hl.monitor({ output = 'DP-1', disabled = false, mode = '2560x1440@240', position = '0x0', scale = 1 })"
    sleep 1
    echo "1Monitor setup complete"
    ;;
  *)
    notify-send "Error" "Unknown mode: $1" && exit 1
    ;;
esac

notify-send "✓ Monitor setup complete: $1"
